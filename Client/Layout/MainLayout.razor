@using Client.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Client.Auth
@using Client.Services.Auth

@inject NavigationManager Navigation
@inject TokenStorageService TokenStorage
@inject JwtAuthenticationStateProvider AuthStateProvider

@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" class="me-3" target="_blank">About</a>
        
            @* Add authentication *@
            <AuthorizeView>
                <Authorized>
                    <div class="me-3 pl-5">
                        Hello @context.User.Identity?.Name
                    </div>

                    <Button
                        Style="ButtonStyle.Ghost"
                        OnClick="Logout">
                        Logout
                    </Button>
                </Authorized>

                <NotAuthorized>
                    <Button
                        Style="ButtonStyle.Ghost"
                        Href="/login">
                        Login
                    </Button>

                    <Button
                        Style="ButtonStyle.Ghost"
                        Href="/register">
                        Register
                    </Button>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <ToastContainer />
            <DialogContainer />
            
            @Body
        </article>
    </main>
</div>

@code
{
        private async Task Logout()
    {
        await TokenStorage.ClearTokenAsync();
        AuthStateProvider.NotifyUserLogout();
        Navigation.NavigateTo("/");
    }
}