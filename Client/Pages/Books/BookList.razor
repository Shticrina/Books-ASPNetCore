@page "/books"

@using Shared.DTOs.Books
@using Client.Interfaces.Api
@using Client.Services.UI
@using Client.Models

@inject IJSRuntime JS
@inject IBookApiService BookService
@inject DialogService DialogService
@inject ToastService Toast

<PageHeader Title="Books">
    <Button Style="ButtonStyle.Success"
             Href="/books/create">
        Create Book
    </Button>
</PageHeader>

@if (isLoading)
{
    <LoadingSpinner />
}
else
{
    <TableToolbar
        SearchText="@searchText"
        SearchChanged="@OnSearchChanged">

        <FilterDropdown TValue="int"
                Items="@categoryFilters"
                Value="@selectedCategoryId"
                ValueChanged="@OnCategoryChanged" />
    </TableToolbar>

    @if (filteredBooks.Count == 0)
    {
        <EmptyState
            Title="No books found"
            Message="No books match your search or filter." />
    }
    else
    {
        <DataTable>
            <Header>
                <tr>
                    <th>Title</th>
                    <th>ISBN</th>
                    <th>Published</th>
                    <th>Author</th>
                    <th>Category</th>
                    <th class="text-center">Actions</th>
                </tr>
            </Header>

            <Rows>
                @foreach (var book in PagedBooks)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@book.Isbn</td>
                        <td>@book.PublishedYear</td>
                        <td>@book.AuthorName</td>

                        <td>
                            <Badge Style="@GetCategoryBadge(book.CategoryName)">
                                @book.CategoryName
                            </Badge>
                        </td>

                        <td class="text-center">
                            <div class="flex justify-center gap-2">
                                <Button Style="ButtonStyle.Default"
                                        Href="@($"/books/{book.Id}")">
                                    Details
                                </Button>
                                <Button Style="ButtonStyle.Primary"
                                        Href="@($"/books/edit/{book.Id}")">
                                    Edit
                                </Button>
                                <Button Style="ButtonStyle.Danger"
                                        OnClick="() => DeleteBook(book.Id)">
                                    Delete
                                </Button>
                            </div>
                        </td>
                    </tr>
                }
            </Rows>
        </DataTable>

        <Pagination
            CurrentPage="@currentPage"
            TotalPages="@totalPages"
            PageChanged="@LoadPage" />
    }
}

@code
{
    private List<BookDto> books = [];
    private List<BookDto> filteredBooks = [];
    private List<FilterItem<int>> categoryFilters = [];
    private bool isLoading = true;
    private int? selectedCategoryId;
    private string searchText = "";
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages =>
        (int)Math.Ceiling(filteredBooks.Count / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        books = await BookService.GetBooksAsync();
        BuildCategoryFilters();
        ApplyFilters();
        isLoading = false;
    }

    private void BuildCategoryFilters()
    {
        categoryFilters = books
            .GroupBy(x => new { x.CategoryId, x.CategoryName })
            .OrderBy(x => x.Key.CategoryName)
            .Select(x => new FilterItem<int>
            {
                Value = x.Key.CategoryId,
                Text = x.Key.CategoryName
            })
            .ToList();
    }

    private Task OnSearchChanged(string value)
    {
        searchText = value;
        ApplyFilters();
        return Task.CompletedTask;
    }

    private Task OnCategoryChanged(int? value)
{
    selectedCategoryId = value;
    ApplyFilters();
    return Task.CompletedTask;
}

private void ApplyFilters()
{
    IEnumerable<BookDto> query = books;

    if (!string.IsNullOrWhiteSpace(searchText))
    {
        query = query.Where(book =>
            book.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            book.Isbn.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            book.AuthorName.Contains(searchText, StringComparison.OrdinalIgnoreCase));
    }

    if (selectedCategoryId.HasValue)
    {
        query = query.Where(book =>
            book.CategoryId == selectedCategoryId.Value);
    }

    filteredBooks = query.ToList();

    currentPage = 1;
}

    private IEnumerable<BookDto> PagedBooks =>
        filteredBooks
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    private Task LoadPage(int page)
    {
        currentPage = page;
        return Task.CompletedTask;
    }

    private BadgeStyle GetCategoryBadge(string category)
    {
        return category switch
        {
            "Fantasy" => BadgeStyle.Primary,
            "Science" => BadgeStyle.Info,
            "History" => BadgeStyle.Warning,
            "Biography" => BadgeStyle.Success,
            "Horror" => BadgeStyle.Danger,
            _ => BadgeStyle.Default
        };
    }

    private async Task DeleteBook(int id)
    {
        var confirmed = await DialogService.ConfirmAsync(
    new DialogOptions
            {
                Title = "Delete book",
                Message = "Are you sure you want to delete this book?",
                ConfirmText = "Delete",
                ConfirmStyle = ButtonStyle.Danger
            });

        if (!confirmed)
            return;

        try
        {
            await BookService.DeleteBookAsync(id);
            books.RemoveAll(b => b.Id == id);
            await Toast.Success("Book deleted successfully.");
        }
        catch (Exception ex)
        {
            await Toast.Error(ex.Message);
        }
    }
}